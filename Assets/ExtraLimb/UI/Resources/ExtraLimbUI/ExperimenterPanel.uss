/*
 * 実験者パネル。ExperimenterPanel がコードで組み立てた要素に、このクラスを付ける。
 *
 * 色の決まり：土台はグラファイトの灰色。色は意味のあるところだけに使う。
 *   ティール（--live）…進行中のもの・選んでいるもの・次に押すボタン（アバターの色にそろえる）
 *   琥珀（--caution）…確かめてほしいこと（Re-center がまだ、評価の入力中、記録していない）
 *   赤（--danger）  …異常（追跡切れ、トラッカーが見つからない）と記録中の印
 *   正常な状態には色を付けない。
 * 字：Yu Gothic UI（UIFonts）。太字は Semibold で描かれる。
 */

.el-root {
    --base: rgb(26, 28, 32);
    --surface: rgb(34, 37, 43);
    --control: rgb(44, 48, 55);
    --control-hover: rgb(54, 59, 67);
    --control-active: rgb(36, 39, 45);
    --line: rgb(46, 50, 56);
    --line-strong: rgb(60, 65, 73);
    --text: rgb(236, 234, 229);
    --text-2: rgb(163, 167, 174);
    --text-3: rgb(112, 117, 125);
    --live: rgb(92, 194, 189);
    --live-strong: rgb(118, 212, 207);
    --live-ink: rgb(14, 36, 35);
    --live-tint: rgba(92, 194, 189, 0.18);
    --live-tint-text: rgb(205, 242, 239);
    --caution: rgb(224, 177, 92);
    --danger: rgb(232, 102, 92);
    --danger-soft: rgb(236, 138, 128);

    flex-grow: 1;
    font-size: 13px;
    color: var(--text);
}

/* ======== 左上の表示（離れても読めるように、ここだけ大きく） ======== */

.el-banner {
    position: absolute;
    left: 12px;
    top: 12px;
    min-width: 380px;
    padding: 12px 16px 12px 16px;
    background-color: rgba(20, 22, 26, 0.88);
    border-radius: 10px;
}

.el-banner__meta {
    font-size: 13px;
    color: var(--text-2);
    white-space: nowrap;
}

.el-banner__headline {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    margin-top: 1px;
}

.el-banner__phase {
    font-size: 21px;
    -unity-font-style: bold;
    white-space: nowrap;
    margin-bottom: 3px;
}

.el-banner__timer {
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: lower-right;
    white-space: nowrap;
    margin-left: 28px;
}

/* 角を丸めた箱では中身を切り取らない（下の「入力欄」の注を参照）。中の線は幅が 100% を超えないので切り取りは要らない */
.el-banner__progress {
    height: 3px;
    margin: 6px 0 10px 0;
    background-color: rgba(255, 255, 255, 0.09);
    border-radius: 2px;
}

.el-banner__progress-fill {
    height: 100%;
    width: 0;
    background-color: var(--live);
    border-radius: 2px;
}

.el-banner__limb {
    flex-direction: row;
    align-items: center;
    margin: 1px 0;
}

.el-banner__limb-text {
    font-size: 16px;
    white-space: nowrap;
}

.el-banner__status {
    font-size: 13px;
    color: var(--text-2);
    white-space: nowrap;
    margin-top: 6px;
}

.el-banner__devices {
    margin-top: 10px;
    padding-top: 8px;
    border-top-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.el-banner__device {
    font-size: 13px;
    white-space: nowrap;
    margin: 1px 0;
}

/* 小さな札（追跡切れなど） */
.el-pill {
    font-size: 12px;
    -unity-font-style: bold;
    padding: 1px 8px;
    margin-left: 10px;
    border-radius: 9px;
    white-space: nowrap;
}

.el-pill--danger {
    color: rgb(255, 236, 233);
    background-color: rgb(176, 64, 56);
}

/* 文字の色（左上の表示とパネルで共通） */

.el-live {
    color: var(--live);
}

.el-banner .el-caution,
.el-caution {
    color: var(--caution);
}

/* ======== 右のパネル ======== */

/* 画面の右端に寄せる。第三者視点のカメラはこの幅を除いた左側に描く */
.el-panel {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 448px;
    background-color: var(--base);
    border-left-width: 1px;
    border-color: var(--line);
}

.el-panel__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 14px 18px 10px 16px;
    border-bottom-width: 1px;
    border-color: var(--line);
}

.el-panel__title {
    font-size: 14px;
    -unity-font-style: bold;
}

.el-panel__hint {
    font-size: 11px;
    color: var(--text-3);
}

.el-panel .unity-scroll-view__content-container {
    padding: 0 12px 24px 16px;
}

/* スクロールバー：細く、矢印なし */
.el-panel .unity-scroller--vertical {
    width: 10px;
    min-width: 10px;
    margin: 0;
    border-width: 0;
    background-color: transparent;
}

.el-panel .unity-scroller__low-button,
.el-panel .unity-scroller__high-button {
    display: none;
}

.el-panel .unity-scroller--vertical > .unity-scroller__slider {
    width: 10px;
    margin: 4px 0 4px 0;
    top: 0;
    bottom: 0;
}

.el-panel .unity-scroller--vertical .unity-base-slider__tracker {
    width: 10px;
    left: 0;
    margin: 0;
    background-color: transparent;
    border-width: 0;
}

.el-panel .unity-scroller--vertical .unity-base-slider__dragger {
    width: 4px;
    left: 3px;
    margin: 0;
    background-color: var(--line-strong);
    border-width: 0;
    border-radius: 2px;
}

.el-panel .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgb(84, 90, 100);
}

/* ---- 欄（たためる見出し） ---- */

.el-section {
    margin: 0;
    padding: 0;
    border-bottom-width: 1px;
    border-color: var(--line);
}

.el-section > .unity-foldout__toggle {
    margin: 0;
    padding: 11px 0 11px 0;
}

/* 開閉の印は右端に置き、見出しの字を中身の左端にそろえる */
.el-section > .unity-foldout__toggle > .unity-toggle__input {
    flex-direction: row-reverse;
    justify-content: space-between;
}

.el-section .unity-foldout__text {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--text);
    margin: 0;
    padding: 0;
}

.el-section .unity-foldout__checkmark {
    -unity-background-image-tint-color: var(--text-3);
    margin: 0 2px 0 0;
}

/* 下の余白は中身に付ける（たたんだ欄は上下が同じ高さになる） */
.el-section > .unity-foldout__content {
    margin: -5px 0 0 0;
    padding: 0 0 14px 0;
}

/* 欄にじかに置いたボタン（割り当て・リセットなど）。左右を中身の端にそろえる */
.el-button.el-button--block {
    margin: 3px 0;
}

/* 欄の中の小さな欄（提示順の一覧） */
.el-section--sub {
    padding: 0;
    border-bottom-width: 0;
}

.el-section--sub > .unity-foldout__toggle {
    padding: 8px 0 8px 0;
}

.el-section--sub > .unity-foldout__content {
    padding: 0;
}

.el-section--sub .unity-foldout__text {
    font-size: 12px;
    color: var(--text-2);
}

/* ---- 並び ---- */

.el-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin: 3px -3px;
}

.el-row--nowrap {
    flex-wrap: nowrap;
}

/* 欄の中の小見出し（生やす位置・入力の部位など）。右に操作キーや小さなボタンを置く */
.el-subheader {
    flex-direction: row;
    align-items: center;
    margin: 12px 0 3px 0;
}

.el-subheading {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--text-2);
}

.el-subheader > .el-text {
    margin: 0 8px 0 0;
}

.el-subheader > .el-muted {
    font-size: 11px;
    color: var(--text-3);
}

.el-row > .el-segmented {
    margin: 0 3px;
}

.el-spacer {
    flex-grow: 1;
}

/* ---- 文字 ---- */

.el-text {
    white-space: normal;
    margin: 2px 0;
    padding: 0;
}

.el-row > .el-text {
    margin: 0 3px;
}

.el-field-label {
    color: var(--text-2);
}

.el-row > .el-field-label {
    margin: 0 6px 0 3px;
}

.el-unit {
    color: var(--text-3);
}

.el-row > .el-unit {
    margin: 0 10px 0 -1px;
}

.el-muted {
    color: var(--text-2);
}

.el-warn {
    color: var(--danger-soft);
    -unity-font-style: bold;
}

/* 正常な状態：色を付けない */
.el-ok {
    color: var(--text-2);
}

.el-mono {
    min-width: 54px;
    -unity-text-align: middle-right;
}

/* ---- ボタン ---- */

.el-button {
    margin: 0 3px;
    padding: 0 10px;
    min-height: 30px;
    background-color: var(--control);
    border-width: 0;
    border-radius: 6px;
    color: var(--text);
    font-size: 13px;
}

.el-button:hover {
    background-color: var(--control-hover);
}

.el-button:active {
    background-color: var(--control-active);
}

.el-button:disabled {
    opacity: 0.38;
}

.el-button--grow {
    flex-grow: 1;
    flex-basis: 0;
}

/* 次に押すボタン */
.el-button--primary {
    background-color: var(--live);
    color: var(--live-ink);
    -unity-font-style: bold;
}

.el-button--primary:hover {
    background-color: var(--live-strong);
}

/* 中止 */
.el-button--danger {
    color: var(--danger-soft);
}

/* 選んでいるもの（一覧の行・単独のボタン） */
.el-button--selected {
    background-color: var(--live-tint);
    color: var(--live-tint-text);
}

.el-button--selected:hover {
    background-color: rgba(92, 194, 189, 0.26);
}

/* トラッカーが見つからない入力の部位 */
.el-button--missing {
    color: var(--danger-soft);
}

/* 字だけのボタン（小見出しの右など） */
.el-button--link {
    min-height: 22px;
    padding: 0 6px;
    margin: 0;
    background-color: transparent;
    color: var(--live);
    font-size: 12px;
}

.el-button--link:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

/* 一覧の行（提示順の一覧） */
.el-list-button {
    -unity-text-align: middle-left;
    min-height: 26px;
    margin: 1px 0;
    background-color: transparent;
    color: var(--text-2);
}

.el-list-button.el-button--selected {
    background-color: var(--live-tint);
    color: var(--live-tint-text);
}

/* ---- つながった切り替えボタン（生やす位置・入力の部位・型・評価） ---- */

.el-segmented {
    flex-direction: row;
    flex-grow: 1;
    margin: 3px 0;
    padding: 2px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 8px;
}

.el-segmented > .el-button {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 28px;
    margin: 0;
    padding: 0 6px;
    background-color: transparent;
    color: var(--text-2);
    border-radius: 6px;
}

.el-segmented > .el-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: var(--text);
}

.el-segmented > .el-button--selected {
    background-color: var(--live-tint);
    color: var(--live-tint-text);
    -unity-font-style: bold;
}

.el-segmented > .el-button--selected:hover {
    background-color: rgba(92, 194, 189, 0.26);
    color: var(--live-tint-text);
}

.el-segmented > .el-button--missing {
    color: var(--danger-soft);
}

.el-segmented > .el-button--selected.el-button--missing {
    background-color: rgba(232, 102, 92, 0.18);
    color: rgb(255, 196, 189);
}

.el-segmented--compact > .el-button {
    min-height: 26px;
    padding: 0;
}

/* ---- 入力欄 ----
 * 角丸・背景・枠は外側（TextField）に付け、中の入力（字をはみ出させないように切り取る箱）は角を付けない。
 * 角を丸めた箱で中身を切り取ると、UI Toolkit はステンシルを使う。ステンシルのない描き先（HMD をつないで再生したときの
 * Game ビューなど）では、切り取る形が白く塗られて字が見えなくなる（2026-11-13。身長・肩幅の欄が白い四角になった）。
 */

.el-field {
    width: 56px;
    min-height: 30px;
    margin: 0 3px;
    padding: 0;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line-strong);
    border-radius: 6px;
    overflow: visible;
}

.el-field:focus {
    border-color: var(--live);
}

.el-field .unity-base-text-field__input,
.el-field .unity-text-field__input,
.el-field:hover .unity-base-text-field__input,
.el-field:focus .unity-base-text-field__input {
    flex-grow: 1;
    min-height: 28px;
    margin: 0;
    padding: 0 7px;
    background-color: transparent;
    color: var(--text);
    border-width: 0;
    border-radius: 0;
    -unity-text-align: middle-left;
    --unity-cursor-color: rgb(236, 234, 229);
    --unity-selection-color: rgba(92, 194, 189, 0.45);
}

.el-field .unity-text-element {
    --unity-cursor-color: rgb(236, 234, 229);
    --unity-selection-color: rgba(92, 194, 189, 0.45);
}

.el-field .unity-base-text-field__input--placeholder,
.el-field .unity-text-element--placeholder {
    color: var(--text-3);
}

/* ---- チェックボックス ---- */

.el-toggle {
    margin: 4px 0;
}

.el-row > .el-toggle {
    margin: 0 10px 0 3px;
}

.el-toggle .unity-toggle__checkmark {
    width: 16px;
    height: 16px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: rgb(78, 84, 93);
    border-radius: 4px;
    -unity-background-image-tint-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.el-toggle:hover .unity-toggle__checkmark {
    border-color: rgb(104, 111, 121);
}

.el-toggle:checked .unity-toggle__checkmark,
.el-toggle .unity-toggle__input:checked > .unity-toggle__checkmark {
    background-color: var(--live);
    border-color: var(--live);
    -unity-background-image-tint-color: var(--live-ink);
}

.el-toggle .unity-toggle__text {
    color: var(--text);
    margin-left: 8px;
}

.el-toggle:disabled {
    opacity: 0.38;
}

.el-toggle .unity-base-field__label {
    min-width: 0;
    width: auto;
    display: none;
}

/* ---- 入力の詳細の表 ---- */

.el-table-row {
    flex-direction: row;
    align-items: center;
    margin: 1px 0;
}

.el-table-row > Label {
    margin: 0 2px;
    padding: 0;
    color: var(--text-2);
}

.el-col-name {
    width: 100px;
}

.el-col-num {
    width: 56px;
    -unity-text-align: middle-right;
}

.el-col-unit {
    width: 26px;
}

.el-table-row > .el-used {
    -unity-font-style: bold;
    color: var(--text);
}

/* ---- ホットキーの一覧 ---- */

.el-hotkey-row {
    flex-direction: row;
    margin: 2px 0;
}

.el-hotkey-key {
    width: 104px;
    flex-shrink: 0;
    color: var(--text-2);
    font-size: 12px;
}

/* ---- 条件の進行 ---- */

.el-condition {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--text);
    margin: 2px 0 2px 0;
}

.el-condition.el-muted {
    font-size: 13px;
    -unity-font-style: normal;
    color: var(--text-2);
}

.el-phase {
    font-size: 14px;
    -unity-font-style: bold;
    margin-top: 6px;
}

.el-rating-row {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
}

.el-rating-label {
    width: 186px;
    flex-shrink: 0;
    white-space: normal;
    margin: 0 8px 0 0;
}

.el-current {
    color: var(--caution);
    -unity-font-style: bold;
}

/* ---- モードの切り替え（見出しの右） ---- */

.el-panel__title {
    flex-grow: 1;
}

.el-segmented.el-segmented--mode {
    flex-grow: 0;
    width: 132px;
    margin: 0 12px 0 0;
}

.el-segmented--mode > .el-button {
    min-height: 26px;
}

/* 押せないが選んでいるもの（実験モードの追加肢の設定）は読めるように残す */
.el-button--selected:disabled {
    opacity: 0.8;
}

/* ---- デモ：組み合わせの一覧（行＝入力の部位と型、列＝生やす位置） ---- */

.el-combo-row {
    flex-direction: row;
    align-items: center;
    margin: 1px 0;
}

.el-combo-row--head {
    margin: 2px 0 2px 0;
}

.el-combo-row--site {
    margin-top: 8px;
}

.el-combo-label {
    width: 164px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin: 0;
}

.el-combo-row--head > .el-combo-label {
    font-size: 11px;
    color: var(--text-3);
}

.el-combo-site {
    width: 52px;
    flex-shrink: 0;
    margin: 0;
    -unity-font-style: bold;
}

.el-combo-label > .el-combo-type {
    flex-grow: 1;
    margin: 0;
    color: var(--text-2);
    font-size: 12px;
}

.el-combo-head {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 2px;
    font-size: 11px;
    color: var(--text-3);
    -unity-text-align: middle-center;
}

.el-combo-head.el-combo-chipcol {
    flex-grow: 0;
    flex-basis: auto;
    width: 52px;
    margin: 0 0 0 6px;
}

.el-button.el-combo-cell {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 26px;
    margin: 0 2px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line);
}

.el-button.el-combo-cell:hover {
    background-color: var(--control-hover);
}

.el-button.el-combo-cell.el-button--selected {
    background-color: var(--live);
    border-color: var(--live);
}

/* 小さな札のボタン（実験で使う型） */
.el-button.el-button--chip {
    width: 52px;
    min-height: 22px;
    margin: 0 0 0 6px;
    padding: 0;
    font-size: 11px;
    background-color: transparent;
    border-width: 1px;
    border-color: var(--line-strong);
    border-radius: 11px;
    color: var(--text-3);
}

.el-button.el-button--chip:hover {
    color: var(--text);
    border-color: rgb(104, 111, 121);
}

.el-button.el-button--chip.el-button--selected {
    background-color: var(--live-tint);
    border-color: var(--live);
    color: var(--live-tint-text);
    -unity-font-style: bold;
}
